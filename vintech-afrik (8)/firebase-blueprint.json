{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A customer order for products.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique order ID." },
        "orderNumber": { "type": "number", "description": "Sequential order number." },
        "customerName": { "type": "string", "description": "Name of the customer." },
        "phone": { "type": "string", "description": "Customer phone number." },
        "region": { "type": "string", "description": "Customer region." },
        "address": { "type": "string", "description": "Customer address." },
        "total": { "type": "number", "description": "Total order amount." },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"], "description": "Order status." },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid"], "description": "Payment status." },
        "items": { "type": "array", "description": "List of items in the order." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the order was created." }
      },
      "required": ["customerName", "phone", "total", "status", "createdAt"]
    },
    "Visit": {
      "title": "Visit",
      "description": "A daily visit count.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date", "description": "The date of the visits." },
        "count": { "type": "number", "description": "Number of visits on this date." }
      },
      "required": ["date", "count"]
    },
    "User": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID." },
        "email": { "type": "string", "description": "User email." },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "User role." }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders."
    },
    "/visits/{date}": {
      "schema": "Visit",
      "description": "Daily visit statistics."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles."
    },
    "/presence/{sessionId}": {
      "schema": "object",
      "description": "Real-time presence tracking."
    },
    "/metadata/{docId}": {
      "schema": "object",
      "description": "App metadata and counters."
    }
  }
}
